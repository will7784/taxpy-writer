# ============================================
# ImpuestIA — Asistente Tributario Chileno (local)
# ============================================

# Telegram (obligatorio)
TELEGRAM_BOT_TOKEN=tu_token_de_botfather_aqui

# ── LLM (al menos uno obligatorio) ─────────────────────────────

# Proveedor por defecto para el chat/agente (kimi | gemini | deepseek | openai | custom).
# 'deepseek' es el mas barato (DEFAULT). Si no esta configurado o es invalido, cae a la
# cadena clasica (kimi > gemini > deepseek > openai > custom). Usa 'kimi'/'gemini' para 1M
# de contexto en el chat general (leyes completas) si lo prefieres al bajo costo de DeepSeek.
# DEFAULT_LLM_PROVIDER=deepseek

# Opcion 1: Kimi / Moonshot (recomendado, 1M contexto, leyes completas + modo estudio)
# Consigue tu key en https://platform.moonshot.ai
# KIMI_API_KEY=sk-tu_key_de_moonshot_aqui
# KIMI_BASE_URL=https://api.moonshot.ai/v1
# KIMI_MODEL=kimi-k2-0905-preview
# KIMI_MAX_CONTEXT=1000000

# Opcion 2: Gemini (1M contexto, leyes completas)
GEMINI_API_KEY=tu_key_de_gemini_aqui
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_CONTEXT=1000000

# Opcion 2: DeepSeek V4 (API OpenAI-compatible, base https://api.deepseek.com).
# deepseek-v4-flash = barato/rapido (DEFAULT); deepseek-v4-pro = casos complejos.
# Precios variables (descuento off-peak); ver https://api-docs.deepseek.com/quick_start/pricing
# DEEPSEEK_API_KEY=sk-tu_key_de_deepseek_aqui
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_MODEL_PRO=deepseek-v4-pro
# DEEPSEEK_MAX_CONTEXT=128000

# Opcion 3: OpenAI (128K contexto)
# OPENAI_API_KEY=sk-tu_key_de_openai_aqui
# OPENAI_MODEL=gpt-4o

# Opcion 4: Cualquier API OpenAI-compatible (Qwen, Moonshot, Zhipu, etc.)
# CUSTOM_LLM_API_KEY=tu_key
# CUSTOM_LLM_BASE_URL=https://api.tu-proveedor.com/v1
# CUSTOM_LLM_MODEL=nombre-modelo
# CUSTOM_LLM_MAX_CONTEXT=128000

# ── Servicios opcionales ──────────────────────────────────────

# Tavily: busqueda en vivo de jurisprudencia/circulares
# TAVILY_API_KEY=tvly-tu_key_de_tavily_aqui

# Produccion: fuentes oficiales y alertas. Las URL se separan por coma.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=usa_un_secreto_largo
# SESSION_SECRET=usa_un_secreto_aleatorio_largo
# ADMIN_TELEGRAM_CHAT_IDS=123456789
# OFFICIAL_SYNC_HOUR=06:15
# OFFICIAL_SYNC_TIMEZONE=America/Santiago
# BCN_LEYCHILE_URLS=https://www.bcn.cl/leychile/navegar?idNorma=...
# CONGRESS_SOURCE_URLS=https://www.bcn.cl/laborparlamentaria/...
# DIARIO_OFICIAL_URLS=https://www.diariooficial.interior.gob.cl/...
# SII_OFFICIAL_URLS=https://www.sii.cl/pagina/jurisprudencia/legis.htm

# Jurisdiccion activa del agente (chile | colombia). Colombia requiere corpus
# propio en knowledge/laws/colombia/ (ver jurisdictions/colombia.py)
# JURISDICCION=chile

# ── MCP (harness externo) ──────────────────────────────────────
# Token bearer que deben enviar el harness/agente (DeepSeek Harness u otro
# cliente MCP) para autenticarse contra el endpoint MCP del panel. En
# producción SIEMPRE debe estar seteado.
# MCP_TOKEN=un_secreto_largo_y_aleatorio
# Ruta base del endpoint MCP (el SSE queda en /mcp/sse).
# MCP_MOUNT_PATH=/mcp

# ── Ingesta automática (webhook tipo n8n / Drive) ──────────────
# Token bearer/X-API-Key para POST el endpoint /api/ingest/{cliente}. Vacío = abierto (dev).
# INGEST_TOKEN=un_secreto_largo_y_aleatorio
# Si es 1/true/yes, al recibir un documento se dispara el pipeline de Co-Work (OCR + análisis).
# INGEST_AUTOPROCESS=1

# ── Notion (salida de informes, Fase 4) ────────────────────────
# Token de integración interna ("ntn_..." o "secret_...") y el id de la base de datos
# donde se publican los informes. Se usan para /api/notion/publish y la tool publicar_notion.
# NOTION_API_KEY=ntn_tu_token_de_integracion_aqui
# NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Propiedad de tipo título de la base (default: Name).
# NOTION_TITLE_PROPERTY=Name

# Supabase: LEGACY — el motor ya usa context_rag (sin chunks ni Supabase).
# Estas variables se ignoran en el runtime. Se conservan solo por compatibilidad.
# SUPABASE_URL=https://tu-proyecto.supabase.co
# SUPABASE_SERVICE_KEY=eyJtu_service_role_key_aqui

# ── Ajustes ───────────────────────────────────────────────────
# ClaudIA investigación: openai, deepseek, gemini, kimi o custom.
# Vacío: OpenAI si está configurado; de lo contrario el proveedor habitual.
# RESEARCH_LLM_PROVIDER=openai
# Si el proveedor elegido no tiene créditos y DEEPSEEK_API_KEY existe, ClaudIA
# continuará la investigación con DeepSeek sin eliminar fuentes.
# ClaudIA solicita al buscador el máximo por consulta y analiza todas las fuentes pertinentes.
# TAVILY_RESULTS_PER_QUERY=20
# RESEARCH_FETCH_CONCURRENCY=6
# RESEARCH_ANALYSIS_CONCURRENCY=1
# RESEARCH_EVIDENCE_CHARS_PER_BATCH=60000
# Salida de hallazgos/informe y espera para respuestas extensas (sin recortar fuentes).
# RESEARCH_MAX_OUTPUT_TOKENS=8000
# RESEARCH_LLM_TIMEOUT_SECONDS=240
# Presupuesto compartido: se corta antes de superar el límite y la
# investigación queda disponible para reanudarla.
# RESEARCH_MONTHLY_BUDGET_USD=150
# RESEARCH_RUN_BUDGET_USD=15
# RESEARCH_RESERVED_FINAL_SHARE=0.25
# LIBRARY_LOOKBACK_DAYS=14
# BACKUPS_DIR=./backups
# WRITER_MAX_TOKENS=8000
# WRITER_TEMPERATURE=0.2

# ── SII Browser Agent (fase futura) ───────────────────────────
# SII_RUT=12.345.678-9
# SII_CLAVE=tu_clave_sii
